{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaBridge",
  "version": "0.1.0",
  "identifier": "dev.wabridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WaBridge",
        "width": 980,
        "height": 660,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Move WhatsApp from Android to iPhone, free.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/wabridge-engine"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "linux": { "deb": { "depends": ["android-tools-adb", "usbmuxd"] } }
  }
}
